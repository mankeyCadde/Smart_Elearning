# ---------------------------------------------------------------------------
# SmartLearn Django backend environment variables
#
# Local development: copy this file to backend/.env (git-ignored) and it will be
# loaded automatically by config/settings.py.
# Production: set these variables in your hosting platform's dashboard (for
# example Render -> Environment). Real environment variables always override
# values from a local .env file. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Local dev: True. Production: False (this is also the safe default when unset).
DJANGO_DEBUG=True

# Required in production. Generate a strong value with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated explicit hostnames, no wildcards. Required in production.
# Example: api.example.com,example-api.onrender.com
DJANGO_ALLOWED_HOSTS=

# --- Cross-origin (React SPA -> Django API) ---------------------------------
# The actual React frontend origin(s), comma-separated, including scheme.
# Required for the deployed frontend to call the API.
# Example: https://app.example.com
DJANGO_CORS_ALLOWED_ORIGINS=

# Origins trusted for CSRF-protected requests (Django admin / session POSTs),
# including scheme. Example: https://app.example.com,https://api.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# When set, the project uses PostgreSQL. When empty, it falls back to the local
# SQLite file backend/db.sqlite3 (development default).
#
# Neon example (keep it ONLY in the environment / .env, never in source):
#   DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Neon pooled endpoint (host contains "-pooler"): also set
#   DJANGO_DB_CONN_MAX_AGE=0
DATABASE_URL=

# Persistent-connection lifetime in seconds for PostgreSQL (default 600).
# Set to 0 when using a transaction-mode connection pooler (Neon pooled host).
DJANGO_DB_CONN_MAX_AGE=600

# --- Production-only security toggles ---------------------------------------
# Redirect plain HTTP to HTTPS (default: true in production).
DJANGO_SECURE_SSL_REDIRECT=True
# Trust the proxy's X-Forwarded-Proto header (default: true on Render). Set to
# false only if Django itself terminates TLS.
DJANGO_TRUST_PROXY_SSL=True

# --- Frontend base URL (used in password-reset emails) ----------------------
FRONTEND_BASE_URL=http://localhost:5173

# --- Email ------------------------------------------------------------------
# Development default: console backend. Production requires SMTP (or another
# real backend) and must never use the console backend.
# Example production values:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=...
#   EMAIL_HOST_PASSWORD=...
#   EMAIL_USE_TLS=True
#   DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@smartlearn.local

# --- Payments ---------------------------------------------------------------
# Paid checkout is disabled unless this demo mode is enabled while DEBUG=True.
# Do not enable it in production; integrate a verified payment provider first.
PAYMENTS_DEMO_MODE=False

# --- Media / assignment uploads --------------------------------------------
# Use a persistent disk path in production (for example /var/data/media), or
# configure S3-compatible private object storage with django-storages
# (install django-storages[s3] and boto3 in requirements.txt).
DJANGO_MEDIA_ROOT=
# DJANGO_MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
ASSIGNMENT_MAX_UPLOAD_BYTES=10485760
# Comma-separated allowlists. Override only if the course requires other formats.
ASSIGNMENT_ALLOWED_FILE_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,csv,txt,rtf,odt,ods,odp,zip,png,jpg,jpeg,gif,webp
ASSIGNMENT_ALLOWED_CONTENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv,text/plain,application/rtf,application/vnd.oasis.opendocument.text,application/vnd.oasis.opendocument.spreadsheet,application/vnd.oasis.opendocument.presentation,application/zip,image/png,image/jpeg,image/gif,image/webp
